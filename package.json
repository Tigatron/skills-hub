{
  "name": "skills-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first library and distribution manager for Agent Skills",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:renderer": "vite",
    "build": "tauri build",
    "build:renderer": "vite build",
    "tauri": "tauri",
    "bindings:generate": "cargo run --quiet --manifest-path src-tauri/Cargo.toml --example export-bindings",
    "bindings:check": "cargo test --manifest-path src-tauri/Cargo.toml --test bindings",
    "docs:check": "node scripts/check-docs.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.{json,js,ts,md,yaml,yml}\" && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.{json,js,ts,md,yaml,yml}\" && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "lint": "eslint . --max-warnings 0 && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && cargo test --manifest-path src-tauri/Cargo.toml --all-features",
    "test:frontend": "vitest run",
    "test:frontend:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --all-features",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm bindings:check && pnpm docs:check && pnpm build:renderer"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-aria-components": "1.19.0",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
